# Copy to .env.local and fill in your values.
# Expo public vars are bundled into the app — never put secrets here.

# Backend API URL (your Next.js app)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# For physical device testing, use your machine's LAN IP:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.x:3000
